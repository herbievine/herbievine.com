---
import dayjs from "dayjs";
import { getLangFromUrl, getLocalizedPath } from "../i18n/utils";

interface Props {
  id: string;
  data: {
    title: string;
    description: string;
    publishedDate: Date;
    draft: boolean;
    tags?: string[] | undefined;
  };
}

const { id, data } = Astro.props;

const urlLang = getLangFromUrl(Astro.url);
const path = getLocalizedPath(`/blog/${id}`, urlLang);

const publishedLabel = dayjs(data.publishedDate).format("dddd D MMMM, YYYY");
---

<div class="flex flex-col space-y-1">
  <a href={path} class="text-lg font-bold text-neutral-800 dark:text-neutral-200 hover:underline">
    {data.title}
  </a>
  <p class="text-neutral-500 dark:text-neutral-400">
    {publishedLabel}
  </p>
  <p class="text-neutral-800 dark:text-neutral-200">
    {data.description}
  </p>
</div>
