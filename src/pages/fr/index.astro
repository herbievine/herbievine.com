
---
import { useTranslations } from '../../i18n/utils'
import Base from '../../layouts/base.astro'

const t = useTranslations('fr')
---

<Base title={t('home.title')}>
  <div class="w-full flex flex-col space-y-16 sm:space-y-24">
    <div class="flex flex-col space-y-2">
      <h1 class="text-xl font-bold text-neutral-800 dark:text-neutral-200">
        {t('home.title')}
      </h1>
      <p class="text-neutral-500 dark:text-neutral-400">
        {t('home.location')}
      </p>
      <p class="text-neutral-800 dark:text-neutral-200">
        {t('home.about')}
      </p>
    </div>
    <div class="flex flex-col space-y-6">
      <h2 class="text-neutral-800 dark:text-neutral-200">
        {t('work.title')}
      </h2>
      <div class="flex flex-col space-y-1">
        <p>
          <span class="text-lg font-bold text-neutral-800 dark:text-neutral-200">
            <a href="https://terros.io" target="_blank">
              {t('work.terros.title')}
            </a>
          </span>
          <span class="text-neutral-500 dark:text-neutral-400">
            - {t('work.terros.description')}
          </span>
        </p>
        <p class="text-neutral-500 dark:text-neutral-400">
          {t('work.terros.role')} - {t('work.terros.location')}
        </p>
        <ol>
          {(t('work.terros.items') as string[]).map((item) => (
            <li class="text-neutral-800 dark:text-neutral-200">
              {item}
            </li>
          ))}
        </ol>
      </div>
      <div class="flex flex-col space-y-1">
        <p>
          <span class="text-lg font-bold text-neutral-800 dark:text-neutral-200">
            <a href="https://helloleo.dev" target="_blank">
              {t('work.helloleo.title')}
            </a>
          </span>
          <span class="text-neutral-500 dark:text-neutral-400">
            - {t('work.helloleo.description')}
          </span>
        </p>
        <p class="text-neutral-500 dark:text-neutral-400">
          {t('work.helloleo.role')} - {t('work.helloleo.location')}
        </p>
        <ol>
          {(t('work.helloleo.items') as string[]).map((item) => (
            <li class="text-neutral-800 dark:text-neutral-200">
              {item}
            </li>
          ))}
        </ol>
      </div>
      <div class="flex flex-col space-y-1">
        <p>
          <span class="text-lg font-bold text-neutral-800 dark:text-neutral-200">
            <a href="https://univia.ai" target="_blank">
              {t('work.univia.title')}
            </a>
          </span>
          <span class="text-neutral-500 dark:text-neutral-400">
            - {t('work.univia.description')}
          </span>
        </p>
        <p class="text-neutral-500 dark:text-neutral-400">
          {t('work.univia.role')} - {t('work.univia.location')}
        </p>
        <ol>
          {(t('work.univia.items') as string[]).map((item) => (
            <li class="text-neutral-800 dark:text-neutral-200">
              {item}
            </li>
          ))}
        </ol>
      </div>
      <div class="flex flex-col space-y-1">
        <p>
          <span class="text-lg font-bold text-neutral-800 dark:text-neutral-200">
            <a href="https://inflowpay.com" target="_blank">
              {t('work.inflow.title')}
            </a>
          </span>
          <span class="text-neutral-500 dark:text-neutral-400">
            - {t('work.inflow.description')}
          </span>
        </p>
        <p class="text-neutral-500 dark:text-neutral-400">
          {t('work.inflow.role')} - {t('work.inflow.location')}
        </p>
        <ol>
          {(t('work.inflow.items') as string[]).map((item) => (
            <li class="text-neutral-800 dark:text-neutral-200">
              {item}
            </li>
          ))}
        </ol>
      </div>
      <div class="flex flex-col space-y-1">
        <p>
          <span class="text-lg font-bold text-neutral-800 dark:text-neutral-200">
            <a href="https://payback.co" target="_blank" class="hover:underline">
              {t('work.payback.title')}
            </a>
          </span>
          <span class="text-neutral-500 dark:text-neutral-400">
            - {t('work.payback.description')}
          </span>
        </p>
        <p class="text-neutral-500 dark:text-neutral-400">
          {t('work.payback.role')} - {t('work.payback.location')}
        </p>
        <ol>
          {(t('work.payback.items') as string[]).map((item) => (
            <li class="text-neutral-800 dark:text-neutral-200">
              {item}
            </li>
          ))}
        </ol>
      </div>
      <div class="flex flex-col space-y-1">
        <p>
          <span class="text-lg font-bold text-neutral-800 dark:text-neutral-200">
            {t('work.wn.title')}
          </span>
          <span class="text-neutral-500 dark:text-neutral-400">
            - {t('work.wn.description')}
          </span>
        </p>
        <p class="text-neutral-500 dark:text-neutral-400">
          {t('work.wn.role')} - {t('work.wn.location')}
        </p>
        <ol>
          {(t('work.wn.items') as string[]).map((item) => (
            <li class="text-neutral-800 dark:text-neutral-200">
              {item}
            </li>
          ))}
        </ol>
      </div>
    </div>
    <div class="flex flex-col space-y-6">
      <h2 class="text-neutral-800 dark:text-neutral-200">
        {t('links.title')}
      </h2>
      <div class="flex flex-col sm:flex-row space-y-2 sm:space-y-0 sm:space-x-4">
        <a href="https://x.com/herbievine" target="_blank" class="text-neutral-600 dark:text-neutral-500 underline">
          {t('links.x')}
        </a>
        <a href="https://github.com/herbievine" target="_blank" class="text-neutral-600 dark:text-neutral-500 underline">
          {t('links.github')}
        </a>
        <a href="https://cal.com/herbievine/30min" class="text-neutral-600 dark:text-neutral-500 underline">
          {t('links.bookCall')}
        </a>
        <a href="mailto:me@herbievine.com" class="text-neutral-600 dark:text-neutral-500 underline">
          {t('links.email')}
        </a>
      </div>
    </div>
  </div>
</Base>
